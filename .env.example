# ─── LiteLLM ──────────────────────────────────────────────────────────────────
# Мастер-ключ администратора. ОБЯЗАТЕЛЬНО начинается с "sk-".
# Генерация: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-REPLACE_WITH_RANDOM_HEX_64

# Соль для шифрования ключей в БД. Задайте один раз и НЕ меняйте —
# иначе все сохранённые ключи станут нечитаемыми.
# Генерация: echo "sk-$(openssl rand -hex 32)"
LITELLM_SALT_KEY=sk-REPLACE_WITH_ANOTHER_RANDOM_HEX_64

# Логин/пароль администратора в веб-интерфейсе.
# UI_USERNAME может быть любым (почта не обязательна).
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_DB=litellm
# Генерация: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_48

# ─── Порты и ресурсы ──────────────────────────────────────────────────────────
# 0.0.0.0 — доступ извне, 127.0.0.1 — только через reverse proxy.
LITELLM_BIND=0.0.0.0
LITELLM_PORT=4000
LITELLM_WORKERS=2

# Лимиты подбираются под сервер. Оставьте запас для ОС.
LITELLM_MEM_LIMIT=2g
LITELLM_CPUS=1.5
PG_MEM_LIMIT=512m
PG_CPUS=0.5

# ─── Провайдер (OpenAI-совместимый) ───────────────────────────────────────────
# Любой OpenAI-compatible endpoint: z.ai, OpenRouter, vLLM, Ollama и т.д.
OPENAI_COMPATIBLE_API_BASE=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=REPLACE_WITH_PROVIDER_KEY
